[Unit]
Description=AI Workflow Demo Login Service
After=network.target mysqld.service mysql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zzq/workspace/ai-workflow/demo
EnvironmentFile=/home/zzq/workspace/ai-workflow/demo/.env
ExecStart=/home/zzq/workspace/ai-workflow/demo/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
