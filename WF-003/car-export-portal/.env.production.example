PORT=3001
KIE_UPLOAD_URL=https://kieai.riftrunnerai.com/api/file-stream-upload
KIE_API_KEY=replace-with-your-kie-api-key

# Upload storage priority:
# 1) Qiniu (when all QINIU_* are set)
# 2) KIE upload fallback
QINIU_ACCESS_KEY=replace-with-your-qiniu-access-key
QINIU_SECRET_KEY=replace-with-your-qiniu-secret-key
QINIU_BUCKET=replace-with-your-qiniu-bucket
QINIU_DOMAIN=replace-with-your-qiniu-domain
QINIU_UPLOAD_URL=https://upload.qiniup.com

# 鈹€鈹€ Workflow upstream (server.js reads these in priority order) 鈹€鈹€
# 1. WF_003_WEBHOOK_URL  鈥?direct webhook (e.g. n8n), highest priority
# 2. WF_003_MIDDLE_PLATFORM_URL 鈥?full URL to the middle-platform json-execute endpoint
# 3. WORKFLOW_API_BASE + WORKFLOW_SUBMIT_PATH 鈥?base + path, lowest priority
#
# For systemd / bare-metal: configure ONE of the following groups.

# Option A 鈥?go through the middle-platform (recommended for production)
WF_003_MIDDLE_PLATFORM_URL=http://127.0.0.1:3002/api/v1/workflows/WF-003/json-execute

# Option B 鈥?direct n8n webhook (bypasses middle-platform point settlement)
# WF_003_WEBHOOK_URL=https://n8n.example.com/webhook/wf003-kie-submit-123

# Option C 鈥?base + path (fallback)
# WORKFLOW_API_BASE=http://127.0.0.1:3002
# WORKFLOW_SUBMIT_PATH=/webhook/wf003-kie-submit-123


