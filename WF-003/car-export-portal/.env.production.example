PORT=3001
KIE_UPLOAD_URL=https://kieai.redpandaai.co/api/file-stream-upload
KIE_API_KEY=replace-with-your-kie-api-key

# ── Workflow upstream (server.js reads these in priority order) ──
# 1. WF_003_WEBHOOK_URL  – direct webhook (e.g. n8n), highest priority
# 2. WF_003_MIDDLE_PLATFORM_URL – full URL to the middle-platform json-execute endpoint
# 3. WORKFLOW_API_BASE + WORKFLOW_SUBMIT_PATH – base + path, lowest priority
#
# For systemd / bare-metal: configure ONE of the following groups.

# Option A – go through the middle-platform (recommended for production)
WF_003_MIDDLE_PLATFORM_URL=http://127.0.0.1:3002/api/v1/workflows/WF-003/json-execute

# Option B – direct n8n webhook (bypasses middle-platform point settlement)
# WF_003_WEBHOOK_URL=https://n8n.example.com/webhook/wf003-kie-submit

# Option C – base + path (fallback)
# WORKFLOW_API_BASE=http://127.0.0.1:3002
# WORKFLOW_SUBMIT_PATH=/webhook/wf003-kie-submit
