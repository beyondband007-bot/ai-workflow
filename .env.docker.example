MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=auth_demo
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me

MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:5.7.44
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.24.0
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20.20.0-bookworm
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12.3-bookworm
DEBIAN_APT_MIRROR=mirrors.aliyun.com
NODEJS_DIST_MIRROR=https://npmmirror.com/mirrors/node

PORT=3002
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=change-me
DATABASE_NAME=auth_demo
DATABASE_URL=mysql+pymysql://app_user:change-me@db:3306/auth_demo

JWT_SECRET=change-me
CALLBACK_SIGNING_SECRET=change-me
CALLBACK_SIGNING_TOLERANCE_SECONDS=300

PYTHON_EXECUTABLE=python3
WF_001_SCRIPT_PATH=/app/WF_001/WF_001.py
WF_001_MOCK_MODE=off
KIE_UPLOAD_URL=https://kieai.redpandaai.co/api/file-stream-upload
KIE_API_KEY=change-me
MIDDLE_PLATFORM_BASE=http://app:3002/api/v1
WF_002_WEBHOOK_URL=
WF_002_WEBHOOK_TIMEOUT_MS=180000
WF_003_WEBHOOK_URL=
WF_003_WEBHOOK_TIMEOUT_MS=720000
MIDDLE_PLATFORM_PUBLIC_BASE_URL=https://example.com
WF_003_CALLBACK_BASE_URL=https://example.com
WF_003_CALLBACK_TOKEN=change-me

# sandbox or production
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=change-me

# docker-compose mounts ./secrets/payment-keys into /run/secrets/payment-keys:ro for the app container.
ALIPAY_PRIVATE_KEY_PATH=/run/secrets/payment-keys/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/run/secrets/payment-keys/alipay_public_key.pem
