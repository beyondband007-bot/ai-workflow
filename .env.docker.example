MYSQL_ROOT_PASSWORD=RootDemo123!
MYSQL_DATABASE=auth_demo
MYSQL_USER=app_user
MYSQL_PASSWORD=RootDemo123!

MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:5.7.44
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.24.0
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20.20.0-bookworm
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12.3-bookworm
DEBIAN_APT_MIRROR=mirrors.aliyun.com
NODEJS_DIST_MIRROR=https://npmmirror.com/mirrors/node

PORT=3002
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=RootDemo123!
DATABASE_NAME=auth_demo

JWT_SECRET=replace-with-your-jwt-secret
CALLBACK_SIGNING_SECRET=replace-with-your-callback-signing-secret
CALLBACK_SIGNING_TOLERANCE_SECONDS=300

PYTHON_EXECUTABLE=python3
WF_001_SCRIPT_PATH=/app/WF_001/WF_001.py
WF_001_MOCK_MODE=off
MIDDLE_PLATFORM_BASE=http://app:3002/api/v1
WF_002_WEBHOOK_URL=https://n8n.deepsix.store/webhook/simple-prompt
WF_002_WEBHOOK_TIMEOUT_MS=180000

# WF-003 Python worker (replaces n8n)
WF_003_WEBHOOK_URL=http://wf003-worker:3013/webhook/wf003-kie-submit
WF_003_WORKER_BASE_URL=http://wf003-worker:3013
WF_003_CALLBACK_BASE_URL=https://your-mid-platform-domain
MIDDLE_PLATFORM_PUBLIC_BASE_URL=https://your-mid-platform-domain
WF_003_CALLBACK_TOKEN=replace-with-wf003-callback-token
WF_003_WEBHOOK_TIMEOUT_MS=60000
WF003_PUBLIC_BASE_URL=https://your-wf003-worker-domain
# Optional explicit callback URL; if empty, worker uses WF003_PUBLIC_BASE_URL/webhook/wf003-kie-callback
WF003_KIE_CALLBACK_URL=
KIE_API_KEY=replace-with-kie-api-key
KIE_CREATE_TASK_URL=https://api.kie.ai/api/v1/jobs/createTask
KIE_IMAGE_MODEL=nano-banana-2

# Feishu app used by the worker to upload generated assets into Bitable
FEISHU_APP_ID=replace-with-feishu-app-id
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_BASE_URL=https://open.feishu.cn
WF003_FEISHU_RETRY_COUNT=4
WF003_FEISHU_RETRY_DELAY_SECONDS=5
WF003_FEISHU_UPLOAD_DELAY_SECONDS=2
WF003_FEISHU_FIELD_NUMBER=编号
WF003_FEISHU_FIELD_CAR_NAME=车名
WF003_FEISHU_FIELD_EXTERIOR=外观附件
WF003_FEISHU_FIELD_INTERIOR=内饰附件
